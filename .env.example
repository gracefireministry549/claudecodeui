# Aureon Environment Configuration
# Provider/API charges remain with the provider; Aureon itself has no upgrade/paywall gate.

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
SERVER_PORT=3001
VITE_PORT=5173
HOST=0.0.0.0

# Claude CLI override, when needed.
# CLAUDE_CLI_PATH=claude

# Keep long-running provider agents alive while background work is running.
# CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=600000

# =============================================================================
# DATABASE / PERSISTENT STORAGE
# =============================================================================
# Use a persistent Render disk path for production so auth, sessions and Aureon
# task checkpoints survive deploys/restarts. Example when a disk is mounted at /var/data:
# DATABASE_PATH=/var/data/aureon/auth.db
# Local/default installations may omit this and use the existing ~/.cloudcli location.

# Optional platform API protection.
# API_KEY=
# JWT_SECRET=

# Claude Code context window size.
VITE_CONTEXT_WINDOW=160000
CONTEXT_WINDOW=160000
